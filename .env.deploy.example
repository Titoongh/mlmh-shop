# .env.deploy — Source de vérité pour TOUS les secrets de déploiement.
# Copier vers .env.deploy (gitignored) et remplir les valeurs.
# Ce fichier alimente à la fois :
#   - les secrets GitHub Actions  → scripts/setup-github-secrets.sh
#   - les secrets Docker Swarm    → scripts/create-docker-secrets.sh
#
# NE JAMAIS committer .env.deploy dans git.

# ── CI/CD (GitHub Actions) ────────────────────────────────────────────────────
DOCKER_USERNAME=
DOCKER_PASSWORD=
SERVER_HOST=92.113.25.5
SSH_PORT=22
SSH_USER=root
# SSH_PRIVATE_KEY_NOPW → uploadée séparément depuis son fichier (voir setup-github-secrets.sh)

# ── Build-time (baked into Docker image via --build-arg) ──────────────────────
# Ces valeurs sont publiques (préfixe NEXT_PUBLIC_) mais doivent quand même
# être versionnées ici pour que le script CI puisse les injecter au build.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_BASE_URL=https://michel-lelong-guitar-tab-workshop.com
NEXT_PUBLIC_API_URL=https://michel-lelong-guitar-tab-workshop.com
# Base URL publique du bucket images Scaleway (lecture publique) — figée dans le
# bundle client par SmartImage. SANS elle, toutes les images du bucket cassent.
NEXT_PUBLIC_IMAGE_BASE_URL=https://s3.fr-par.scw.cloud/mlmh

# Build-time placeholder (Prisma génère le client dans le builder stage)
DATABASE_URL_BUILD=prisma+postgres://accelerate.prisma-data.net/?api_key=PLACEHOLDER
STRIPE_SECRET_KEY_BUILD=sk_test_placeholder

# ── Runtime (Docker Swarm secrets — montés à /run/secrets/<NOM>) ──────────────
DATABASE_URL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
BREVO_API_KEY=
MLMH_CLERK_SECRET_KEY=
MLMH_SCW_REGION=
MLMH_SCW_BUCKET_ENDPOINT=
MLMH_SCW_DEFAULT_ORGANIZATION_ID=
MLMH_SCW_DEFAULT_PROJECT_ID=
MLMH_SCW_ACCESS_KEY=
MLMH_SCW_SECRET_KEY=
MLMH_SCW_BUCKET_NAME=
MLMH_SCALEWAY_TABLATURES_BUCKET=
# Auth de POST /api/revalidate + warmup des pages SSG au démarrage (entrypoint).
# SANS elle, le warmup est sauté → pages SSG (DB) rendues VIDES en prod.
# Générer : openssl rand -hex 32
REVALIDATE_API_KEY=
