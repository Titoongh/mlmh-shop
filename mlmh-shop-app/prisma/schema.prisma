datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native", "linux-musl-arm64-openssl-3.0.x"]
  previewFeatures = ["strictUndefinedChecks"]
}

model Artist {
  id            String         @id @default(uuid())
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  name          String         @unique
  slug          String         @unique
  musicalGenres MusicalGenre[] @relation("ArtistMusicalGenre")
  contents      Content[]
  tablatures    Tablature[]
  methods       Method[]       @relation("ArtistMethod")
  description   String?
  hidden        Boolean        @default(false)

  @@index([id])
  @@index([name])
}

model Tablature {
  id              String          @id @default(uuid())
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  title           String
  slug            String          @unique
  price           Float           @default(5)
  publicationDate DateTime?
  musicalGenres   MusicalGenre[]  @relation("TablatureMusicalGenre")
  contents        Content[]
  artists         Artist[]
  description     String?
  Download        Download[]
  files           TablatureFile[] // New relation to files
  hidden          Boolean         @default(false)
  PurchaseItem    PurchaseItem[]

  @@index([id])
  @@index([title])
}

// New model for storing multiple files per tablature
model TablatureFile {
  id          String    @id @default(uuid())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  filename    String // Original filename
  scalewayKey String // Key in Scaleway storage
  fileSize    Int? // File size in bytes
  mimeType    String? // MIME type of the file
  tablature   Tablature @relation(fields: [tablatureId], references: [id], onDelete: Cascade)
  tablatureId String

  @@index([tablatureId])
  @@index([scalewayKey])
}

// Each tablature/method can have multiple contents (audio, video, etc.)
model Content {
  id          String      @id @default(uuid())
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  type        ContentType
  url         String?
  blob        Bytes?
  tablature   Tablature?  @relation(fields: [tablatureId], references: [id], onDelete: Cascade)
  tablatureId String?
  rank        Int
  Artist      Artist?     @relation(fields: [artistId], references: [id])
  artistId    String?
  method      Method?     @relation(fields: [methodId], references: [id], onDelete: Cascade)
  methodId    String?
}

model MusicalGenre {
  id         String      @id @default(uuid())
  name       String      @unique
  artists    Artist[]    @relation("ArtistMusicalGenre")
  tablatures Tablature[] @relation("TablatureMusicalGenre")
  methods    Method[]    @relation("MethodMusicalGenre")
}

// Guitar method volume (e.g. "The Guitar of Merle Travis - Volume 2").
// The sellable unit is MethodOffer, never the Method itself: a method sells as
// a FULL package, a DOCUMENTS-only booklet, or per-LESSON. Delivered files are
// derived from MethodFile.role + MethodFile.lessonId (see lib/methods/delivery.ts).
model Method {
  id              String         @id @default(uuid())
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  title           String
  slug            String         @unique
  description     String?
  hidden          Boolean        @default(false)
  publicationDate DateTime?
  artists         Artist[]       @relation("ArtistMethod")
  musicalGenres   MusicalGenre[] @relation("MethodMusicalGenre")
  contents        Content[]
  lessons         MethodLesson[]
  files           MethodFile[]
  offers          MethodOffer[]

  @@index([id])
  @@index([title])
}

model MethodLesson {
  id        String        @id @default(uuid())
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  title     String
  rank      Int
  method    Method        @relation(fields: [methodId], references: [id], onDelete: Cascade)
  methodId  String
  files     MethodFile[]
  offers    MethodOffer[]

  @@index([methodId])
}

model MethodFile {
  id          String         @id @default(uuid())
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  filename    String
  scalewayKey String
  fileSize    Int?
  mimeType    String?
  role        MethodFileRole
  method      Method         @relation(fields: [methodId], references: [id], onDelete: Cascade)
  methodId    String
  lesson      MethodLesson?  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  lessonId    String? // null = method-level file (e.g. booklet cover)

  @@index([methodId])
  @@index([lessonId])
  @@index([scalewayKey])
}

// App-level invariants (enforced in lib/admin/methods.ts, not expressible here
// because Postgres treats NULL lessonId as distinct in a @@unique):
// max 1 FULL and 1 DOCUMENTS offer per method, 1 LESSON offer per lesson,
// lessonId required iff kind = LESSON.
model MethodOffer {
  id           String          @id @default(uuid())
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  kind         MethodOfferKind
  title        String // e.g. "Complete package", "PDF booklet", "Lesson: Guitar Rag"
  price        Float // EUR, same convention as Tablature.price
  hidden       Boolean         @default(false)
  method       Method          @relation(fields: [methodId], references: [id], onDelete: Cascade)
  methodId     String
  lesson       MethodLesson?   @relation(fields: [lessonId], references: [id])
  lessonId     String?
  PurchaseItem PurchaseItem[]

  @@index([methodId])
  @@index([lessonId])
}

enum MethodFileRole {
  DOCUMENT
  AUDIO
  VIDEO
}

enum MethodOfferKind {
  FULL // all documents + all audio/video lessons
  DOCUMENTS // booklet only (all DOCUMENT files)
  LESSON // one lesson: its own files only
}

enum ContentType {
  AUDIO
  VIDEO
  IMAGE
}

model DownloadIntent {
  id              String         @id @default(uuid())
  email           String?
  success         Boolean?
  // Explicit lifecycle (mirrors Purchase.status). `success` is kept for backward
  // compatibility: true = paid, false = payment failed, null = pending/expired.
  status          PurchaseStatus @default(PENDING)
  // Exactly-once marker for the download email (claimed atomically by whichever
  // of webhook / success page confirms the payment first).
  emailSentAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  stripeSessionId String         @unique
  downloads       Download[]

  @@index([stripeSessionId])
  @@index([status])
}

model Download {
  id               String         @id @default(uuid())
  downloadIntent   DownloadIntent @relation(fields: [downloadIntentId], references: [id], onDelete: Cascade)
  downloadIntentId String
  tablature        Tablature      @relation(fields: [tablatureId], references: [id])
  tablatureId      String

  @@index([downloadIntentId])
  @@index([tablatureId])
}

model User {
  id        String   @id // This will be the Clerk user ID
  email     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationship to Stripe customer
  stripeCustomer StripeCustomer?

  // Direct relationship to purchases for easier querying
  purchases Purchase[]

  @@index([email])
}

// Stripe Customer model - bridges User and Stripe
model StripeCustomer {
  id               String   @id @default(uuid())
  stripeCustomerId String   @unique // The actual Stripe customer ID
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Link to our User
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @unique

  // All purchases made by this customer
  purchases Purchase[]

  @@index([stripeCustomerId])
  @@index([userId])
}

// New Purchase model - more robust than DownloadIntent
model Purchase {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Stripe information
  stripeSessionId       String  @unique
  stripePaymentIntentId String?
  stripeCustomerId      String // Denormalized for faster queries

  // Purchase details
  totalAmount Int // Amount in cents
  currency    String         @default("usd")
  status      PurchaseStatus @default(PENDING)
  // Exactly-once marker for the download email (see DownloadIntent.emailSentAt)
  emailSentAt DateTime?

  // User and customer relationships
  user           User?          @relation(fields: [userId], references: [id])
  userId         String? // Nullable for anonymous purchases
  stripeCustomer StripeCustomer @relation(fields: [stripeCustomerId], references: [stripeCustomerId])

  // Items purchased
  purchaseItems PurchaseItem[]

  @@index([stripeSessionId])
  @@index([stripeCustomerId])
  @@index([userId])
  @@index([status])
}

// Items within a purchase - more flexible than the current Download model
model PurchaseItem {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  purchaseId String

  // Exactly one of tablatureId / methodOfferId is set (app-level invariant,
  // enforced in checkout-v2 and stripe-sync; optional Postgres CHECK can be
  // added by hand in the migration SQL).
  // onDelete: Restrict is explicit: optional relations default to SetNull,
  // which would silently orphan purchase history when deleting a sold product.
  tablature   Tablature? @relation(fields: [tablatureId], references: [id], onDelete: Restrict)
  tablatureId String?

  methodOffer   MethodOffer? @relation(fields: [methodOfferId], references: [id], onDelete: Restrict)
  methodOfferId String?

  // Price at time of purchase (for historical accuracy)
  priceAtPurchase Int // Amount in cents
  currency        String @default("usd")

  @@index([purchaseId])
  @@index([tablatureId])
  @@index([methodOfferId])
}

enum PurchaseStatus {
  PENDING // Payment not yet confirmed
  PAID // Payment successful, files accessible
  FAILED // Payment failed
  REFUNDED // Payment was refunded
  CANCELLED // Session was cancelled/expired
}
